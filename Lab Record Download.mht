dius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="99687e79-cf47-4e12-8c5e-76b9d0c4eb31" data-undisplayed="undisplayed">dfs_directed_graph.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="a3b64e4b-8d1a-4fec-ba62-91256f8ad5bf" data-undisplayed="undisplayed">#include&lt;stdio.h&gt;
#include&lt;stdlib.h&gt;
#define MAX 100
int adj[MAX][MAX];
int visited[MAX];
int adjcount[MAX];
int compare(const void*a,const void *b){
	return(*(int*)a-*(int*)b);
}
void dfs (int vertex){
	visited[vertex]=1;
	printf("%d ",vertex);
	for(int i=0;i&lt;adjcount[vertex];i++){
		int neighbor = adj[vertex][i];
		if(!visited[neighbor]){
			dfs(neighbor);
		}
	}
}
int main(){
	int vertices,edges;
	scanf("%d %d",&amp;vertices,&amp;edges);
	for(int i=0;i&lt;edges;i++){
		int u,v;
	scanf("%d %d",&amp;u,&amp;v);
	adj[u][adjcount[u]++]=v;
}
for(int i=0;i&lt;vertices;i++){
	qsort(adj[i],adjcount[i],sizeof(int),compare);
}
int start;
scanf("%d",&amp;start);
dfs(start);
return 0;
}</pre><br data-ref="05174227-592b-43ea-ba02-86731dcfb7ca"></div></div><div class="row" data-ref="a8995727-0158-4d47-834b-91119f04c151"><div class="col-12" data-ref="913474dc-6a17-4b7e-aced-88cf6719a8cd"><h5 class="execResultsHeading text-center" data-ref="80ccae4b-3894-4c8f-a6c2-48392eca84c4">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="e0ac5b6f-69c0-4d5c-8bd6-dc334881cb47" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="2585658d-c31d-4a7e-aebf-4afaf003a10a"><div class="row execution-results-border" data-ref="e229ccfd-1180-47c1-8172-c990074eb041"><div class="col-12 p-2 text-center font-weight-bold" data-ref="c52938d2-3813-4b45-a450-82461fe70cc5">Test Case - 1</div></div><div class="row execution-results-border" data-ref="8ba6195a-15db-49ca-8d7d-6ddb17d4a1b8"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="fa3703c4-5900-4128-bff5-e759c8ce1c91">User Output</div></div><div class="row execution-results-border" data-ref="d526a6fd-c0b6-49f8-98e9-e8bbb1c93351"><div class="col-6" data-ref="9e42cb68-bade-442a-8cb5-8c30db672da4"><span class="cmd" title="User Input" data-ref="95bbd6ae-31bd-4d10-824f-789e2154d577">5 6</span></div></div><div class="row execution-results-border" data-ref="947c860c-6239-4818-8c8d-a4f7982e4303"><div class="col-6" data-ref="4f611791-1094-4061-8895-7e4e07601de6"><span class="cmd" title="User Input" data-ref="9e74742d-5e60-499e-9785-d98abc526df4">0 1</span></div></div><div class="row execution-results-border" data-ref="290b0220-6b7e-43b0-b6e5-7da408850a0c"><div class="col-6" data-ref="5f6d6e87-e29c-4e9e-9e2c-c7ecc867f637"><span class="cmd" title="User Input" data-ref="843a14d1-b448-47bd-aa6f-523a6d8b1c5b">0 2</span></div></div><div class="row execution-results-border" data-ref="aad2d944-55df-42ad-8a11-0daee50f33f7"><div class="col-6" data-ref="586597e2-bf3d-4226-af6b-0576573bb157"><span class="cmd" title="User Input" data-