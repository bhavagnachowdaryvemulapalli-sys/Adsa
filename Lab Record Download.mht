#include&lt;stdio.h&gt;
#include&lt;limits.h&gt;
#define MAX 100
 #define INF INT_MAX
int m,n;
int graph[MAX][MAX];
int minDistance(int dist[],int visited[]){
int min =INF,min_index=-1;
	for(int v=0;v&lt;n;v++){
		if(!visited[v]&amp;&amp;dist[v]&lt;=min){
			min=dist[v];
			min_index=v;
		}
	}
	return min_index;
}
void dijkstra(int src){
	int dist[MAX];
	int visited[MAX];
	for(int i=0;i&lt;n;i++){
		dist[i]=INF;
		visited[i]=0;
	}
	dist[src]=0;
		for(int count=0;count&lt;n-1;count++){
			int u= minDistance(dist,visited);
			if(u==-1)break;
			visited[u]=1;
			for(int v=0;v&lt;n;v++){
				if(!visited[v]&amp;&amp;graph[u][v]!=INF&amp;&amp;dist[u]!=INF&amp;&amp;(long long)dist[u]+graph[u][v]&lt;dist[v]){
					dist[v]=dist[u]+graph[u][v];
				}
			}
		}
	for(int i=0;i&lt;n;i++){
		if(dist[i]==INF)
			printf("%d -1\n",i);
		else 
			printf("%d %d\n",i,dist[i]);
	}
}
int main(){
	scanf("%d%d",&amp;n,&amp;m);
	for(int i=0;i&lt;n;i++)
		for(int j=0;j&lt;n;j++)
			graph[i][j]=INF;
	for(int i=0;i&lt;m;i++){
		int u,v,w;
		scanf("%d%d%d",&amp;u,&amp;v,&amp;w);
		graph[u][v]=w;
	}
	int src;
	scanf("%d",&amp;src);
	dijkstra(src);
	return 0;
}</pre><br data-ref="9737861b-87fb-4a5b-8258-bd440aedb2fd"></div></div><div class="row" data-ref="96425b12-1e42-4b16-bf73-b7a427d21458"><div class="col-12" data-ref="a9fe045b-a3c3-436d-9911-b1ff17ae3d76"><h5 class="execResultsHeading text-center" data-ref="46145fa0-0369-419a-88e6-2ed4b8681e7d">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="8df974c4-6992-4b80-9dc0-3e70f39fa65d" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="0a7d9ceb-462c-4a3a-a1be-25d919685b98"><div class="row execution-results-border" data-ref="4aa867ed-135c-4482-9190-7da2f1f5c24e"><div class="col-12 p-2 text-center font-weight-bold" data-ref="cf8b187b-c7a6-481f-8ba2-885a066af661">Test Case - 1</div></div><div class="row execution-results-border" data-ref="e528b7ad-4f25-440b-b842-a3f9e3ebe224"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="11be5212-c224-4eda-a3ac-e7bdc4b7256c">User Output</div></div><div class="row execution-results-border" data-ref="52ef3074-4bc0-4d54-853a-b2dbd6e892ff"><div class="col-6" data-ref="c4a7211e-08ec-4918-beb1-ce9a3bdf37f7"><span class="cmd" title="User Input" data-ref="2a6b1cf2-f791-414c-8c78-c0a08095931b">4 3</span></div></div><div class="row execution-results-border" data-ref="4bb5b889-16f7-4bd3-b0d6-adbd4c872f98"><div class="col-6" data-ref="dc9c1974-148c-4e0d-b87b-d20d0b39b409"><span class="cmd" title="User Input" data-ref="2e90480f-9ccf-41af-9231-e4d28d03df74">0 1 2</span></div></div><div class="row execution-results-border" data-ref="e17d77fa-3d5b-4add-88ce-b8b8cf308d15"><div class="col-6" data-ref="5ec97980-becb-4205-8bbf-cd9a05b3d352"><span class="cmd" title="User Input" data-ref="1e30bdb0-d4c4-4d98-a60a-a38a3aa09a98">0 2 5</span></div></div><div class="row execution-results-border" data-ref="c94ed1c1-0ea4-4524-9f86-3c3ff29af882"><div class="col-6" data-ref="2b37673f-17b5-4005-bebf-cef80a9e2c97"><span class="cmd" title="User Input" d