" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="8487bed1-dc5f-4ef7-95c0-255f9e3b8ec0">Note: </strong>Refer to the test cases for better understanding.</p></span></div><div class="mb-3" data-ref="8c5bcb9f-ce9e-43dd-adcb-56785824664c"><div class="ml-1 mb-3" data-ref="2bb0eb56-145a-4a62-9972-94afddecdae2"><b style="border-bottom:1px solid black;" data-ref="550ad7b1-0719-4c6f-9dc7-5cab54664be2" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="ee599fbe-9702-461b-be0b-40dfc833554f" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="3657800e-2219-48ed-905b-1fa466271031" data-undisplayed="undisplayed">BFS.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="d88bc0f3-6a32-4592-aa05-9896e7cc0b59" data-undisplayed="undisplayed">#include &lt;stdio.h&gt;
#include &lt;stdlib.h&gt;
#define MAX 100
int adj[MAX][MAX];    
int adjCount[MAX];     
int visited[MAX];      
int queue[MAX];        
int front = 0, rear = 0;
int compare(const void *a, const void *b) {
    return (*(int *)a - *(int *)b);
}
void enqueue(int v) {
    queue[rear++] = v;
}
int dequeue() {
    return queue[front++];
}
int isEmpty() {
    return front == rear;
}
void bfs(int start) {
    visited[start] = 1;
    enqueue(start);
    while (!isEmpty()) {
          int current = dequeue();
		printf("%d ", current);
		for (int i = 0;i &lt; adjCount[current]; i++) {
			int neighbor = adj[current][i];
			if (!visited[neighbor]) {
				visited[neighbor] = 1;
				enqueue(neighbor);
		}
		}
	}
}
int main() {
	int vertices, edges;
	scanf("%d %d", &amp;vertices, &amp;edges);
	for (int i = 0; i &lt; vertices; i++) {
		adjCount[i] = 0;
		visited[i] = 0;
	}
	for(int i = 0; i &lt; edges; i++) {
		int u, v;
		scanf("%d %d", &amp;u, &amp;v);
		adj[u][adjCount[u]++] = v;
	}
	for (int i = 0; i &lt; vertices; i++) {
		qsort(adj[i], adjCount[i], sizeof(int), compare);
	}
	int start;
	scanf("%d", &amp;start);
	bfs(start);
	return 0;
}</pre><br data-ref="abd4cf42-c293-4dad-b8c5-838a1a98386e"></div></div><div class="row" data-ref="001cced3-6a79-4fa6-985f-474d144bd18e"><div class="col-12" data-ref="1d8e7cf1-f81f-456d-b025-8057cf385203"><h5 class="execResultsHeading text-center" data-ref="e7df852e-dd55-4bec-b7ec-73359c169851">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="7fbf2579-86d7-4263-b6a0-65e51d7e48f1" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="347ebbcd-72c6-49db-881b-e52a82f747e5"><div class="row execution-results-border" data-ref="a524900d-daa9-4029-b72f-b11cbee3642e"><div class="col-12 p-2 text-center font-weight-bold" data-ref="b217feec-f03a-40c8-9edb-5bd0026e4343">Test Case - 1</div></div><div class="row execution-results-border" data-ref="0395acf5-74a2-4b9f-9ce2-0ca1dd4d7ffd"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="3830e577-4ce0-4687-b57c-d0830e47ec15">User Output</div></div><div class="row execution-results-border" data-ref="1d3d65fb-a9ad-4f8c-bb39-359b867ac11d"><div class="col-6" data-ref="112cc29f-9b0c-4587-970d-1b4f1ee49370"><span class="cmd" title="User Input" data-ref="b1968515-d88d-433d-9dcd-9539b03436ab">5 4</span></div></div><div class="row execution-results-border" data-ref="4bd45155-0699-4dc0-99f1-bd95f8d07178"><div class="col-6" data-ref="7b563554-c6b0-4d71-a5e7-3b510f4c4893"><span class="cmd" title="User Input" data-ref="d1afae79-d62c-4767-9631-18ff1656e262">0 1</span></div></div><div class="row execution-results-border" data-ref="12c2c1ed-5a6e-4ac4-81c8-23f6f93c54da"><div class="col-6" data-ref="6b0a68e4-b291-41b8-99af-3b205c00885d"><span class="cmd" title="User Input" data-ref="9c011321-e1d5-4ae7-b775-4f8385427495">0 2</span></div></div><div class="row execution-results-border" data-ref="222da3fc-ee47-415b-9763-2228e4fa3580"><div class="col-6" data-ref="13079c04-2682-471a-bc6f-987f8dba6627"><span class="cmd" title="User Input" data-