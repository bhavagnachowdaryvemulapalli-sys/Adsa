#include&lt;stdlib.h&gt;
int knapsack(int weights[],int n,int profits[],int m){
	int M [n+1][m+1];
	for(int i=0;i&lt;=n;i++){
		for(int j =0;j&lt;=m;j++){
			if(i==0||j==0)
				M[i][j]=0;
			else if(weights[i-1]&lt;=j)
				M[i][j] = (profits[i-1]+M[i-1][j-weights[i-1]]&gt;M[i-1][j]?profits[i-1]+M[i-1][j-weights[i-1]]:M[i-1][j]);
			else
				M[i][j]=M[i-1][j];
		}
	}
	return M[n][m];
}
int main(){
	int n;
	scanf("%d",&amp;n);
	int weights[n];
	for(int i=0;i&lt;n;i++){
		scanf("%d",&amp;weights[i]);
	}
	int profits[n];
	for(int i=0;i&lt;n;i++){
		scanf("%d",&amp;profits[i]);
	}
	int capacity;
	scanf("%d",&amp;capacity);
	int maxprofit = knapsack(weights,n,profits,capacity);
	printf("%d\n",maxprofit);
	return 0;
}</pre><br data-ref="f2e3522e-54c9-4bc6-a959-915189ef32c8"></div></div><div class="row" data-ref="67038e8c-3df8-4b9a-9c05-9690d72ad0e2"><div class="col-12" data-ref="6aaa2cb3-2a02-42e0-9140-2e238d7d0106"><h5 class="execResultsHeading text-center" data-ref="2d9af4eb-d19e-4849-a78a-12ea7a6ae8e2">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="2f710bcf-4550-4c35-87a5-c458e131eaba" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="18cb3c61-3a12-422c-acef-2e29d262fee3" data-split-to="18cb3c61-3a12-422c-acef-2e29d262fee3" data-split-original="true" data-last-split-element="true" data-align-last-split-element="auto"><div class="row execution-results-border" data-ref="5c686e88-c42a-4870-9bdf-dff6ff4add4e"><div class="col-12 p-2 text-center font-weight-bold" data-ref="0696d5d7-2201-47ca-ab1e-9ba85db4cfa0">Test Case - 1</div></div><div class="row execution-results-border" data-ref="08dcc63a-4308-479d-bf70-16e19aa5ebf2"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="5b1e60a1-f8fe-4281-be4a-94f992644002">User Output</div></div></div></div></div></div></div></div></div>
