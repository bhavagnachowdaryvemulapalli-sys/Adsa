scanf("%d",&amp;n);
for(i=0;i&lt;n;i++){
scanf("%d",&amp;val);
insert(val);}
printHeap();
scanf("%d\n",&amp;del);
for(int i=0;i&lt;del;i++){
deleteMin();}
printHeap();
printf("\n");
