#include&lt;stdlib.h&gt;
#define MAX 100
int adj[MAX][MAX];
int visited[MAX];
int adjcount[MAX];
int compare(const void*a,const void *b){
	return(*(int*)a-*(int*)b);
}
void dfs (int vertex){
	visited[vertex]=1;
	printf("%d ",vertex);
	for(int i=0;i&lt;adjcount[vertex];i++){
		int neighbor = adj[vertex][i];
		if(!visited[neighbor]){
			dfs(neighbor);
		}
	}
}
int main(){
	int vertices,edges;
	scanf("%d %d",&amp;vertices,&amp;edges);
	for(int i=0;i&lt;edges;i++){
		int u,v;
	scanf("%d %d",&amp;u,&amp;v);
	adj[u][adjcount[u]++]=v;
}
for(int i=0;i&lt;vertices;i++){
	qsort(adj[i],adjcount[i],sizeof(int),compare);
}
int start;
scanf("%d",&amp;start);
dfs(start);
return 0;
}</pre><br data-ref="05174227-592b-43ea-ba02-86731dcfb7ca"></div></div><div class="row" data-ref="a8995727-0158-4d47-834b-91119f04c151"><div class="col-12" data-ref="913474dc-6a17-4b7e-aced-88cf6719a8cd"><h5 class="execResultsHeading text-center" data-ref="80ccae4b-3894-4c8f-a6c2-48392eca84c4">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="e0ac5b6f-69c0-4d5c-8bd6-dc334881cb47" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="2585658d-c31d-4a7e-aebf-4afaf003a10a" data-split-to="2585658d-c31d-4a7e-aebf-4afaf003a10a" data-split-original="true" data-last-split-element="true" data-align-last-split-element="auto"><div class="row execution-results-border" data-ref="e229ccfd-1180-47c1-8172-c990074eb041"><div class="col-12 p-2 text-center font-weight-bold" data-ref="c52938d2-3813-4b45-a450-82461fe70cc5">Test Case - 1</div></div><div class="row execution-results-border" data-ref="8ba6195a-15db-49ca-8d7d-6ddb17d4a1b8"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="fa3703c4-5900-4128-bff5-e759c8ce1c91">User Output</div></div></div></div></div></div></div></div></div>
