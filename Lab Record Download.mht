<div class="container-xl" data-ref="93bff089-900e-4c10-be2f-0bbe2c0a5505"><header class="text-right" data-ref="57df8a3a-75e4-4f38-a735-5a2e64a2353e"> </header> <div class="page" data-ref="c2753eab-e1f7-4076-bb42-7b7556bb181d"><div id="lab-print" data-ref="9c66e823-6846-4c89-846c-974f61baca1c" data-id="lab-print"><div class="ct-print-new-page-after-always" data-ref="9d02a60d-46d0-4ef5-976b-3c8bac8c2576" data-break-after="always"><div data-ref="6cb4e471-d38f-4842-87bf-b012326100f4"><table class="table table-condensed table-bordered table-hover" data-ref="f3081409-1264-4631-8f8a-2fe6cf9aca46"><thead data-ref="7a585880-8d83-498f-90f0-2a133eb1bc70"><tr data-ref="a784fb5f-b2e3-420d-b62e-232c202e4633"><th class="text-left align-middle" style="width:20%" data-ref="026dee5b-ba73-4a44-b2f9-e5fef781a55c" data-undisplayed="undisplayed">S.No: 1</th> <th class="text-left align-middle" style="width:55%; font-weight: normal;" data-ref="44a7f058-ba0f-4929-b8e8-a95a232a0642" data-undisplayed="undisplayed">Exp. Name: <b class="expTitle" data-ref="3654a93f-ca85-4220-9e76-b10afa02a9dc"><i data-ref="ee2a89e2-577d-40e6-aa29-125ec0d17f2b">Program to implement AVL tree and its operations</i></b></th> <th class="text-left align-middle" style="width:25%" data-ref="6377cbfb-4c6b-49db-9dbb-0a78dd9fc5d6" data-undisplayed="undisplayed">Date: 2026-08-19</th></tr></thead></table></div><div class="ml-1" style="page-break-inside: auto" data-ref="0942d004-85be-4e90-9078-6ebfb8a5078c" data-undisplayed="undisplayed"><b style="border-bottom:1px solid black;" data-ref="6015c480-4d1c-45da-b3a1-b0ecbd8f593d" data-undisplayed="undisplayed">Aim:</b><br data-ref="fac0a933-fa88-475e-aa78-a27da5402c93"> <span class="question-text ql-editor" data-ref="225cb92d-d83c-403f-bf02-a1368909b565"><p data-ref="1c598739-f0a0-46e8-b29d-2220fd8bbf59" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0">Write a program to create an AVL tree using a provided set of elements stored in a file. Implement operations for inserting and deleting elements from the AVL tree. After constructing the tree, output the contents of the tree in in-order traversal to a new file.</p><p data-ref="01cb5a4f-18f5-4d90-aa3e-41492afb8f35" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="5ca573b0-3bdd-4bc9-9234-4ce920750a2a"></p><p data-ref="09e3fa9a-e1ac-4cd4-93ee-ed04f565f454" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="0debafc7-9b2d-4d50-8cc2-b82d1c4c1fa1">Note: </strong>Refer to visible test cases for better understanding.</p></span></div><div class="mb-3" data-ref="b9248f7b-afe5-48b7-bc59-c7f660e2efea"><div class="ml-1 mb-3" data-ref="7f4d41f5-7c08-4944-9a42-0d6bf9450084"><b style="border-bottom:1px solid black;" data-ref="2cbaee8a-354c-4ef3-bd39-d76e3d897f90" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="cadd1dab-ab5b-46a1-be84-b26ee71db81a" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="fead6a12-4d6c-4297-b2f9-359d19a37ab7" data-undisplayed="undisplayed">avl_tree.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="4768f5ef-8700-4723-b4f4-fbf2f19cb0e3" data-undisplayed="undisplayed">#include&lt;stdio.h&gt;
#include&lt;stdlib.h&gt;
#include&lt;string.h&gt;
#include&lt;stdbool.h&gt;
typedef struct Node{
int key;
struct Node* left;
struct Node* right;
int height;
}Node;
int height(Node*N){
	if(N==NULL)return 0;
	return N-&gt;height;
}
int max(int a,int b){
	return(a&gt;b)?a:b;
}
Node*newNode(int key){
	Node*node=(Node*)malloc(sizeof(Node));
	node-&gt;key=key;
	node-&gt;left=node-&gt;right=NULL;
	node-&gt;height=1;
	return node;
}
Node *rightRotate(Node*y){
	Node*x=y-&gt;left;
	Node*T2=x-&gt;right;
	x-&gt;right=y;
	y-&gt;left=T2;
	y-&gt;height=max(height(y-&gt;left),height(y-&gt;right))+1;
	x-&gt;height=max(height(x-&gt;left),height(x-&gt;right))+1;
	return x;
}
Node*leftRotate(Node* x){
	Node*y=x-&gt;right;
	Node*T2=y-&gt;left;
	y-&gt;left=x;
	x-&gt;right=T2;
	x-&gt;height=max(height(x-&gt;left),height(x-&gt;right))+1;
	y-&gt;height=max(height(y-&gt;left),height(y-&gt;right))+1;
	return y;
}
int getBalance(Node*N){
	if(N==NULL)
		return 0;
	return height(N-&gt;left)-height(N-&gt;right);
}
Node*insert(Node*node,int key){
	if(node==NULL)
		return newNode(key);
	if(key&lt;node-&gt;key)
		node-&gt;left=insert(node-&gt;left,key);
	else if(key&gt;node-&gt;key)
		node-&gt;right=insert(node-&gt;right,key);
	else
		return node;
	node-&gt;height=1+max(height(node-&gt;left),height(node-&gt;right));
	int balance=getBalance(node);
	if(balance&gt;1&amp;&amp;key&lt;node-&gt;left-&gt;key)
		return rightRotate(node);
	if(balance&lt;-1&amp;&amp;key&gt;node-&gt;right-&gt;key)
		return leftRotate(node);
	if(balance&gt;1&amp;&amp;key&gt;node-&gt;left-&gt;key){
		node-&gt;left=leftRotate(node-&gt;left);
		return rightRotate(node);
	}
	if(balance&lt;-1&amp;&amp;key&lt;node-&gt;right-&gt;key){
		node-&gt;right=rightRotate(node-&gt;right);
		return leftRotate(node);
	}
	return node;
}
Node*minValueNode(Node*node){
	Node*current=node;
	while(current-&gt;left)
		current=current-&gt;left;
	return current;
}
Node*deleteNode(Node*root,int key,int*found){
	if(!root) return root;
	if(key&lt;root-&gt;key)
		root-&gt;left=deleteNode(root-&gt;left,key,found);
	else if(key&gt;root-&gt;key)
		root-&gt;right=deleteNode(root-&gt;right,key,found);
	else{
		*found=1;
		if(!root-&gt;left||!root-&gt;right){
			Node*temp=root-&gt;left?root-&gt;left:root-&gt;right;
			if(!temp){
				temp=root;
				root=NULL;
			}else
				*root=*temp;
			free(temp);
		}else{
			Node*temp=minValueNode(root-&gt;right);
			root-&gt;key=temp-&gt;key;
			root-&gt;right=deleteNode(root-&gt;right,temp-&gt;key,found);
		}
	}
	if(!root)return root;
	root-&gt;height=1+max(height(root-&gt;left),height(root-&gt;right));
	int balance=getBalance(root);
	if(balance&gt;1&amp;&amp;getBalance(root-&gt;left)&gt;=0)return rightRotate(root);
	if(balance&gt;1&amp;&amp;getBalance(root-&gt;left)&lt;0){
		root-&gt;left=leftRotate(root-&gt;left);
		return rightRotate(root);
	}
	if(balance&lt;-1&amp;&amp;getBalance(root-&gt;right&lt;=0))
		return leftRotate(root);
		if(balance&lt;-1&amp;&amp;getBalance(root-&gt;right)&gt;0){
		root-&gt;right=rightRotate(root-&gt;right);
		return leftRotate(root);
		}
	return root;
}
void inorder(Node*root,FILE*out){
	if(root){
inorder(root-&gt;left,out);
		fprintf(out ,"%d ",root-&gt;key);
		inorder(root-&gt;right,out);
	}
}
void printInorder(Node*root){
	FILE*temp=tmpfile();
	inorder(root,temp);
	rewind(temp);
	int x;
	while(fscanf(temp, "%d", &amp;x) == 1){
		printf("%d ",x);
	}
	printf("\n");
	fclose(temp);
}
int main(){
	Node*root = NULL;
	char inputFile[20];
	printf("Input file name: ");
	scanf("%s", inputFile);
	FILE* in=fopen(inputFile,"r");
	if(!in){
		printf("Error opening input file\n");
		return 1;
	}
	int val;
	char line[256];
	fgets(line,sizeof(line),in);
	while(fscanf(in,"%d",&amp;val)!=EOF)
		root=insert(root,val);
	fclose(in);
	printf("In-order traversal:\n");
	printInorder(root);
	int choice,key;
	while(1){
		printf("1. Insert\n2. Delete\n3. Write to file and exit\nChoice: ");
		scanf("%d",&amp;choice);
		switch(choice){
			case 1:printf("Element: ");
			scanf("%d", &amp;key);
			root=insert(root, key);
			printf("In-order traversal:\n");
			printInorder(root);
			break;
			case 2:printf("Element: ");
			scanf("%d",&amp;key);
			int found=0;
			root=deleteNode(root,key,&amp;found);
			if(found)
				printf("Deleted %d\n",key);
			else
				printf("%d not found\n",key);
			printf("In-order traversal:\n");
			printInorder(root);
			break;
			case 3:{
				char outputFile[100];
				printf("Output file name: ");
				scanf("%s",outputFile);
				FILE*out=fopen(outputFile,"w");
				if(!out){
					printf("Error opening output file\n");
					return 1;
				}
				inorder(root,out);
				fprintf(out, "\n");
				fclose(out);
				printf("AVL Tree written to file\n");
			return 0;
			}
			default:
			printf("Invalid choice\n");
		}
	}
