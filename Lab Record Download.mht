				<div class="pagedjs_page_content" style="column-width: 624px; column-gap: calc(var(--pagedjs-margin-right) + var(--pagedjs-margin-left));"><div><div class="container-xl" data-ref="93bff089-900e-4c10-be2f-0bbe2c0a5505" data-split-from="93bff089-900e-4c10-be2f-0bbe2c0a5505" data-split-to="93bff089-900e-4c10-be2f-0bbe2c0a5505"><div class="page" data-ref="c2753eab-e1f7-4076-bb42-7b7556bb181d" data-split-from="c2753eab-e1f7-4076-bb42-7b7556bb181d" data-split-to="c2753eab-e1f7-4076-bb42-7b7556bb181d"><div data-ref="9c66e823-6846-4c89-846c-974f61baca1c" data-id="lab-print" data-split-from="9c66e823-6846-4c89-846c-974f61baca1c" data-split-to="9c66e823-6846-4c89-846c-974f61baca1c"><div class="ct-print-new-page-after-always" data-ref="a931c674-fb71-4f3e-879f-93b0bfc08e2a" data-break-after="always" data-split-from="a931c674-fb71-4f3e-879f-93b0bfc08e2a" data-split-to="a931c674-fb71-4f3e-879f-93b0bfc08e2a"><div class="mb-3" data-ref="2058c102-6d43-477a-aef5-b839dceba007" data-split-from="2058c102-6d43-477a-aef5-b839dceba007"><div class="user-solution" style="page-break-inside: auto" data-ref="da279370-14e8-4deb-ab56-e4d3ebb68471" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="e7ea94de-37dd-413f-9c98-1b031b5d643d" data-undisplayed="undisplayed">knapsackBacktracking.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="9973d6cf-a2a9-4ea7-b1eb-7ec9bd3814b3" data-undisplayed="undisplayed">#include&lt;stdio.h&gt;
int n,w;
int maxProfit=0;
int values[100],weights[100];
void knapsack(int i,int currw,int currv){
	if(i==n){
		if(currv&gt;maxProfit)
			maxProfit=currv;
		return;
	}
	if(currw+weights[i]&lt;=w){
		knapsack(i+1,currw+weights[i],currv+values[i]);
	}
	knapsack(i+1,currw,currv);
}
int main(){
	scanf("%d",&amp;n);
	for(int i=0;i&lt;n;i++)
		scanf("%d %d",&amp;values[i],&amp;weights[i]);
	scanf("%d",&amp;w);
