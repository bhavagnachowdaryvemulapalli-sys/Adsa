-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="c544df5c-4d41-4111-80aa-7637d2f54c0d"></p><p data-ref="1a60357e-d841-4148-9006-87439481ef40" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="0d555dea-5413-4900-b528-6aa80b49d908">Output Format:</strong></p><ul data-ref="1782fe33-7ab3-46ef-baa1-59daeff59db5" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><li data-ref="6d2d26a5-c42a-46e1-a6dd-16c1a8fa10ee">Print the BFS traversal of the graph starting from <mjx-container class="MathJax" jax="CHTML" style="font-size: 119.5%; position: relative;" data-ref="679cdb29-daa4-4693-bdc2-ac89297f137f" data-undisplayed="undisplayed"><mjx-math class="MJX-TEX" aria-hidden="true" data-ref="504c8882-7e68-482d-af0a-638c59adacc2"><mjx-mi class="mjx-i" data-ref="250cb3c2-b5d7-4099-886e-d3811498e0b1"><mjx-c class="mjx-c1D446 TEX-I" data-ref="5f4289b9-603d-4809-b197-a292b172eea6"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable="on" display="inline" data-ref="dadb561b-2c1b-48c5-ba1d-43a2d339799c"><math xmlns="http://www.w3.org/1998/Math/MathML" data-ref="d46dbfd6-8250-4dc7-9c5e-0f8a7fbce19d"><mi data-ref="99933536-2a35-4796-a097-1ea0da10d4b3">S</mi></math></mjx-assistive-mml></mjx-container>, with vertices separated by a space. If a vertex has multiple neighbors, process them in increasing order.</li></ul></span></div><div class="mb-3" data-ref="391869de-345e-4b16-b1cd-4eddf790d091"><div class="ml-1 mb-3" data-ref="7ec30de8-fcfc-436e-85ad-f441a735581a"><b style="border-bottom:1px solid black;" data-ref="138ad56f-d12b-4e5b-ac9c-f68c83373af9" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="6d00150c-cf03-4e11-97a9-473113f52eca" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="ee23ba37-c1ba-41ea-a59b-491dd26fccea" data-undisplayed="undisplayed">CTC64721.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="aea983b4-4dbd-45df-952f-79b0d8b6ec3d" data-undisplayed="undisplayed">#include&lt;stdio.h&gt;
#include&lt;stdlib.h&gt;
#define MAX 10
int adj[MAX][MAX];
int visited[MAX];
int queue[MAX];
int front=0,rear=0;
int n;
void enqueue(int vertex){
	queue[rear++]=vertex;
}
int dequeue(){
	return queue[front++];
}
int isEmpty(){
return front == rear;
}
void bfs(int start){
visited[start]=1;
	enqueue(start);
	while(!isEmpty()){
		int current = dequeue();
		printf("%d ",current);
		for(int i=0;i&lt;n;i++){
			if(adj[current][i]==1&amp;&amp;!visited[i]){
				visited[i]=1;
				enqueue(i);
			}
		}
	}
}
int main(){
	int edges,u,v,start;
	scanf("%d",&amp;n);
	scanf("%d",&amp;edges);
	for(int i=0;i&lt;n;i++){
		visited[i]=0;
		for(int j=0;j&lt;n;j++){
			adj[i][j]=0;
		}
	}
	for(int i=0;i&lt;edges;i++){
		scanf("%d %d",&amp;u,&amp;v);
		adj[u][v]=1;
		adj[v][u]=1;
	}
	scanf("%d",&amp;start);
	bfs(start);
	return 0;
}</pre><br data-ref="681fa0c4-93e3-48f3-8c22-087b4a114508"></div></div><div class="row" data-ref="4544fbf6-77e5-4580-8a87-15b9748dba71"><div class="col-12" data-ref="7d34499b-e495-4948-b171-68b88e9b115a"><h5 class="execResultsHeading text-center" data-ref="915d3d78-9c62-4c25-bfb3-46556cc7ab35">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="7e973387-fb35-4b1e-b6c8-4232d23c1c11" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="d52dc9c6-f590-4e7d-b551-697c92a106d0"><div class="row execution-results-border" data-ref="77afc678-cb1c-4dc0-8629-c19fd15784c8"><div class="col-12 p-2 text-center font-weight-bold" data-ref="ba94282e-b463-4fa2-ab24-a89a60fdb679">Test Case - 1</div></div><div class="row execution-results-border" data-ref="e3b37b24-43d2-4e9e-8494-69e104f72fcd"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="43104543-d21c-4175-9bd2-e987db0827d5">User Output</div></div><div class="row execution-results-border" data-ref="170b0da0-a36c-4661-9e26-e76c50db04b8"><div class="col-6" data-ref="c0e835af-c6de-469c-b948-2d9d2ccf12cf"><span class="cmd" title="User Input" data-ref="7a4cdcf7-5ae8-4e27-836d-bf11f5f06d0b">4</span></div></div><div class="row execution-results-border" data-ref="d8a31e10-039c-4587-bacb-cc459600f7c5"><div class="col-6" data-ref="183191f5-800d-4928-9379-b99505d2fe7c"><span class="cmd" title="User Input" data-ref="2fba54db-d978-47a2-84e2-1e279b26496b">4</span></div></div><div class="row execution-results-border" data-ref="fcda02e3-78a7-4153-8ceb-b9647b0fc811"><div class="col-6" data-ref="f5a39fd7-85b7-441d-a1c4-bc04ec652033"><span class="cmd" title="User Input" data-ref="e71399e1-ee56-44ee-94a5-12d68413f17b">0 1</span></div></div><div class="row execution-results-border" data-ref="dbff1fa1-5829-4fc6-8f6a-ff084b9e09d7"><div class="col-6" data-ref="3742a44f-0ebb-4280-97f0-571288b00f26"><span class="cmd" title="User Input" data-ref=