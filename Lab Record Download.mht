			min=dist[v];
			min_index=v;
		}
	}
	return min_index;
}
void dijkstra(int src){
	int dist[MAX];
	int visited[MAX];
	for(int i=0;i&lt;n;i++){
		dist[i]=INF;
		visited[i]=0;
