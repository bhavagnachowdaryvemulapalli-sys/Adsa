int n;
int cost[20][20];
int visited[20];
int mincost=INT_MAX;
void tsp(int city,int count,int cc,int start){
	if(count ==n){
		if(cost[city][start]!=-1&amp;&amp;cc+cost[city][start]&lt;mincost){
			mincost = cc+cost[city][start];
		}
		return;
	}
	for(int i=0;i&lt;n;i++){
		if(!visited[i]&amp;&amp;cost[city][i]!=-1){
			visited[i]=1;
			tsp(i,count+1,cc+cost[city][i],start);
			visited[i]=0;
		}
	}
}
int main(){
	scanf("%d",&amp;n);
	for(int i=0;i&lt;n;i++){
		for(int j=0;j&lt;n;j++){
