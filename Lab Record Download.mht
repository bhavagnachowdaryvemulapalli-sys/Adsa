	qsort(jobs,n,sizeof(Job),compare);
	int maxDeadline=0;
	for(i=0;i&lt;n;i++){
		if(jobs[i].deadline&gt;maxDeadline){
			maxDeadline=jobs[i].deadline;}}
	int slot[maxDeadline+1];
	for(i=0;i&lt;=maxDeadline;i++){
		slot[i]=-1;}
	int  countJobs=0,totalProfit=0;
	for(i=0;i&lt;n;i++){
		for(int j=jobs[i].deadline;j&gt;0;j--){
			if(slot[j]==-1){
				slot[j]=jobs[i].id;
				countJobs++;
				totalProfit+=jobs[i].profit;
				break;}}}
	printf("%d %d\n",countJobs,totalProfit);
	return 0;
}</pre><br data-ref="c650d464-0185-41b9-abdc-d174ccc0eeba"></div></div><div class="row" data-ref="bc977d0f-2503-4949-87c1-aa1f31bea72b"><div class="col-12" data-ref="b97f41f2-a346-4e4d-b613-24c12ce54bde"><h5 class="execResultsHeading text-center" data-ref="67a6aabf-2e61-44f0-b203-afdc2d436451">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="ea0f736a-4032-4cde-8bb3-03a48a85fc2b" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="fff472fa-0e14-4bce-8bfe-d7613fa30a3e"><div class="row execution-results-border" data-ref="de5a214e-136c-44eb-899f-80cbeed06904"><div class="col-12 p-2 text-center font-weight-bold" data-ref="751b7a5c-4baf-44a7-9e5b-cd1cc2102852">Test Case - 1</div></div><div class="row execution-results-border" data-ref="d3d9dbdb-b1d5-4a2e-b2a0-5b8f0adeddf8"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="f0a6d6a7-0a29-41ed-9aa1-fca9ce2a87b5">User Output</div></div><div class="row execution-results-border" data-ref="5e3c827a-8133-4418-bb2c-a05496e1c537"><div class="col-6" data-ref="5b23be38-371b-4c02-835c-012a98c70277"><span class="cmd" title="User Input" data-ref="dc4c857c-6997-4fea-b551-ac0416c802b2">4</span></div></div><div class="row execution-results-border" data-ref="980bf726-65c5-49b8-9fa0-ea92b060882d"><div class="col-6" data-ref="c8b240ef-7e92-44a0-a854-8e6969bab2f4"><span class="cmd" title="User Input" data-ref="9ebca581-bcc1-45a7-a78a-ab36d1e2f728">1 4 20</span></div></div><div class="row execution-results-border" data-ref="24631d65-71b5-40e8-8afa-476ad613c2e6"><div class="col-6" data-ref="426ad2e5-74ec-4a2d-a311-d509bd681dc4"><span class="cmd" title="User Input" data-ref="9445b591-c1a1-486f-8fd9-af5470f2b1ec">2 1 10</span></div></div><div class="row execution-results-border" data-ref="092faba6-7aa8-4946-a862-16dbd3c82941"><div class="col-6" data-ref="6b99aa5f-3135-4812-bbbc-1a282579f6b6"><span class="cmd" title="User Input" d