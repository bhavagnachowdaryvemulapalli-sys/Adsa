void swap(int *a,int *b){
	int temp=*a;
	*a=*b;
	*b=temp;
}
int partition(int arr[],int low,int high){
	int pivort=arr[low];
	int i=low;
	int j=high+1;
	while(i&lt;j){
		do{
			i++;
		}while(arr[i]&lt;=pivort);
		do{
			j--;
		}while(arr[j]&gt;pivort);
		if(i&lt;j)
			swap(&amp;arr[i],&amp;arr[j]);
	}
	swap(&amp;arr[low],&amp;arr[j]);
	return j;
}
void quicksort(int arr[],int low,int high){
	if(low&lt;high){
		int pi = partition(arr,low,high);
		quicksort(arr,low,pi-1);
		quicksort(arr,pi+1,high);
	}
}
int main(){
	int n,i,arr[20];
	scanf("%d",&amp;n);
	for(i=0;i&lt;n;i++){
		scanf("%d",&amp;arr[i]);
	}
	quicksort(arr,0,n-1);
	for(i=0;i&lt;n;i++){
		printf("%d ",arr[i]);
	}
	printf("\n");
}
