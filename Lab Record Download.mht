data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><li data-ref="6b3b4013-58de-439f-877b-658672347865">If a solution exists, print an <mjx-container class="MathJax" jax="CHTML" style="font-size: 119.5%; position: relative;" data-ref="1e5148af-6492-4843-803d-cf90a592cfab" data-undisplayed="undisplayed"><mjx-math class="MJX-TEX" aria-hidden="true" data-ref="ebb7be4c-c133-427f-b8ee-4af22302383b"><mjx-mi class="mjx-i" data-ref="2230f510-c05b-4004-b239-67c38f1ec0db"><mjx-c class="mjx-c1D441 TEX-I" data-ref="45090c51-f3d9-4ddd-946e-937e12abbda7"></mjx-c></mjx-mi><mjx-mi class="mjx-i" data-ref="eae6c38a-fa8b-4402-9745-c1c78396dd37"><mjx-c class="mjx-cD7" data-ref="a78f3e9b-690d-4fb8-9e99-19654671d66c"></mjx-c></mjx-mi><mjx-mi class="mjx-i" data-ref="ab03b5c5-1302-4edd-9051-5abc0d339bdd"><mjx-c class="mjx-c1D441 TEX-I" data-ref="9035fc92-c5f6-4cb4-bd37-4ec477272944"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable="on" display="inline" data-ref="e08ae2f3-5e6a-4346-a376-c5e16dd40cb6"><math xmlns="http://www.w3.org/1998/Math/MathML" data-ref="fae0e817-836d-400d-9ed3-3656f4e80633"><mi data-ref="ecaba6a7-62d2-4c2c-a553-ebeaae5a77aa">N</mi><mi data-ref="0af92b61-c7ab-4233-82fc-aa1f30953777">Ã—</mi><mi data-ref="31be1bb5-8247-4a22-8a2d-ce0d300eb90b">N</mi></math></mjx-assistive-mml></mjx-container> matrix consisting of 0s and 1s, where 1 represents a queen.</li><li data-ref="163286ab-8270-4a19-b621-c97b42ce4e65">If no solution exists, print: "No solution exists for N = &lt;value&gt;".</li><li data-ref="100e3b0a-aa25-4f97-8c75-50aab0afc053">Each row of the matrix should be printed on a new line, with space-separated values.</li></ul><p data-ref="1453c814-6e7f-4adc-9a8a-172635f17dd4" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="85cd52bd-97c4-4cdc-8c37-62540004e745"></p><p data-ref="f981b4af-0ec7-4b6d-b6c5-1052a6b9c9a5" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="94d356c9-7314-4eee-8547-c002238b5429">Note:</strong> Refer to the test cases for better understanding.</p></span></div><div class="mb-3" data-ref="469ad8a0-94e3-464a-8d3b-aa35f0a329b5"><div class="ml-1 mb-3" data-ref="3e664082-b2ce-4b43-8e6b-f8825c4bd4e7"><b style="border-bottom:1px solid black;" data-ref="5c62073c-2e62-4b09-9b26-20024b63732a" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="e931efe1-5d81-4d32-916e-a3a67b17ec10" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="531533ca-8412-4347-85e5-422091b7f0c1" data-undisplayed="undisplayed">nqueens.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="8559121a-21c3-42ba-a41a-4df73caa4720" data-undisplayed="undisplayed">#include&lt;stdio.h&gt;
#include&lt;stdbool.h&gt;
#define MAX 20
int board[MAX][MAX];
void printSolution(int n){
	for(int i=0;i&lt;n;i++){
		for(int j=0;j&lt;n;j++){
			printf("%d ",board[i][j]);
		}
		printf("\n");
	}
}
bool isSafe(int row,int col,int n){
	int i,j;
	for(i=0;i&lt;n;i++){
		if(board[i][col]==1)
			return false;
	}
	for(i=row,j=col;i&gt;=0&amp;&amp;j&gt;=0;i--,j--){
		if(board[i][j]==1)
			return false;
	}
	for(i=row,j=col;i&gt;=0&amp;&amp;j&lt;n;i--,j++){
		if(board[i][j]==1)
			return false;
	}
	return true;
}
bool solveNQueens(int row,int n){
	if(row==n){
		return true;
	}
	for(int col =0;col&lt;n;col++){
		if(isSafe(row,col,n)){
			board[row][col]=1;
			if(solveNQueens(row+1,n)){
				return true;
			}
			board[row][col]=0;
		}
	}
	return false;
}
int main(){
	int n;
	scanf("%d",&amp;n);
	if(n&lt;=0||n&gt;MAX){
		printf("Invalid board size.please use N between 1 and %d\n",MAX);
		return 0;
	}
	for(int i=0;i&lt;n;i++)
		for(int j=0;j&lt;n;j++)
			board[i][j]=0;
	if(solveNQueens(0,n)){
		printSolution(n);
	}
	else{
		printf("No solution exists for N = %d\n",n);
	}
