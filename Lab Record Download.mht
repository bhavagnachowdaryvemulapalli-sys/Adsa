477a-aef5-b839dceba007"><div class="ml-1 mb-3" data-ref="7cff3fd1-e459-48c8-97e5-77e5c45775d0"><b style="border-bottom:1px solid black;" data-ref="c78538ef-26fa-46f3-9e8c-d2373593c326" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="da279370-14e8-4deb-ab56-e4d3ebb68471" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="e7ea94de-37dd-413f-9c98-1b031b5d643d" data-undisplayed="undisplayed">knapsackBacktracking.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="9973d6cf-a2a9-4ea7-b1eb-7ec9bd3814b3" data-undisplayed="undisplayed">#include&lt;stdio.h&gt;
int n,w;
int maxProfit=0;
int values[100],weights[100];
void knapsack(int i,int currw,int currv){
	if(i==n){
		if(currv&gt;maxProfit)
			maxProfit=currv;
		return;
	}
	if(currw+weights[i]&lt;=w){
		knapsack(i+1,currw+weights[i],currv+values[i]);
	}
	knapsack(i+1,currw,currv);
}
int main(){
	scanf("%d",&amp;n);
	for(int i=0;i&lt;n;i++)
		scanf("%d %d",&amp;values[i],&amp;weights[i]);
	scanf("%d",&amp;w);
	knapsack(0,0,0);
	printf("%d\n",maxProfit);
