t="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><li data-ref="3a7d1bdb-7ada-4ff1-9936-fd41f35144db">The first line contains an integer <mjx-container class="MathJax" jax="CHTML" style="font-size: 119.5%; position: relative;" data-ref="8bb198d6-a63e-45ca-abe3-a19fe86aefb7" data-undisplayed="undisplayed"><mjx-math class="MJX-TEX" aria-hidden="true" data-ref="437577c6-2657-49c6-a4f2-33a5c88612c5"><mjx-mi class="mjx-i" data-ref="42cd0c0d-ec22-4981-baf6-7688277d21a8"><mjx-c class="mjx-c1D45B TEX-I" data-ref="240ae608-3d55-47b1-ad2a-a61cba337853"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable="on" display="inline" data-ref="b29e3cca-405d-4528-9d05-00632319f3a7"><math xmlns="http://www.w3.org/1998/Math/MathML" data-ref="2cf64025-948c-4666-a6e3-66b12724b070"><mi data-ref="59a71a0d-28b9-42d1-9121-107ee2205b7a">n</mi></math></mjx-assistive-mml></mjx-container>, representing the number of elements to insert into the heap.</li><li data-ref="b9fd67fa-9856-4b9f-a130-9b18953f75ba">The second line contains <mjx-container class="MathJax" jax="CHTML" style="font-size: 119.5%; position: relative;" data-ref="716d394a-abf1-4aba-8693-82d9d86e4c9c" data-undisplayed="undisplayed"><mjx-math class="MJX-TEX" aria-hidden="true" data-ref="598fb723-f51b-4239-9180-83f0f703c7bb"><mjx-mi class="mjx-i" data-ref="00e6511e-6e43-415f-a4e5-c6d3f1a80149"><mjx-c class="mjx-c1D45B TEX-I" data-ref="e1e0062b-287c-40ea-bc22-1c5a3f436c1c"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable="on" display="inline" data-ref="db26adb6-4776-4cf2-978e-6dc9c23da92d"><math xmlns="http://www.w3.org/1998/Math/MathML" data-ref="07c146e8-db84-42cf-873d-d740da55efcb"><mi data-ref="684b7c0f-ab42-4c77-b9f7-8b4a689e7602">n</mi></math></mjx-assistive-mml></mjx-container> space-separated integers â€” the values to insert into the heap.</li><li data-ref="11df843a-6abe-4c15-86c0-6d99e5556700">The third line contains an integer <mjx-container class="MathJax" jax="CHTML" style="font-size: 119.5%; position: relative;" data-ref="87a20b86-9490-4f5d-8528-a9e81d4b3a32" data-undisplayed="undisplayed"><mjx-math class="MJX-TEX" aria-hidden="true" data-ref="7abb0977-7e25-4140-bc51-d8680a12c472"><mjx-mi class="mjx-i" data-ref="d6cfc104-2c07-4ce2-b597-826ed784a51b"><mjx-c class="mjx-c1D458 TEX-I" data-ref="196892c2-c2fa-44cc-b774-f3894dfb01ed"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable="on" display="inline" data-ref="5ee7e729-5f75-4241-b8d5-742659c56279"><math xmlns="http://www.w3.org/1998/Math/MathML" data-ref="0662b715-cb84-4697-b322-d8fc90faf514"><mi data-ref="1ca773b2-09c8-44a6-806f-7c62ac81045a">k</mi></math></mjx-assistive-mml></mjx-container>, representing the number of times the root (minimum element) should be deleted from the heap.</li></ul><p data-ref="2572c3a8-554a-4624-b4d4-7a82496fa702" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="3295f56e-f0fa-4283-bf30-e200fae84e66"></p><p data-ref="7882ce88-79ad-4130-aa2d-87ec00ac6565" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="dc2a4e90-c22e-41d8-bd0a-bc26efff907a">Output Format:</strong></p><ul data-