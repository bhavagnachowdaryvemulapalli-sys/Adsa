 data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="1b0f425d-a0d5-4f8e-9ad2-c7815557ba00"></p></span></div><div class="mb-3" data-ref="485e61b3-dcc1-40e3-b881-ed85d5a315d7"><div class="ml-1 mb-3" data-ref="bdb426eb-1263-4350-98ed-c75df10f7a66"><b style="border-bottom:1px solid black;" data-ref="59433020-58e4-413e-94e4-5ad131bf92d4" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="be203203-25fe-4463-b685-da4c3cfe82c6" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="57b8da2a-55d1-49bc-a617-62885047c7f4" data-undisplayed="undisplayed">dynamicKs.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="18831ea7-b671-4300-8018-e90761abdc04" data-undisplayed="undisplayed">#include&lt;stdio.h&gt;
#include&lt;stdlib.h&gt;
int knapsack(int weights[],int n,int profits[],int m){
	int M [n+1][m+1];
	for(int i=0;i&lt;=n;i++){
		for(int j =0;j&lt;=m;j++){
			if(i==0||j==0)
				M[i][j]=0;
			else if(weights[i-1]&lt;=j)
				M[i][j] = (profits[i-1]+M[i-1][j-weights[i-1]]&gt;M[i-1][j]?profits[i-1]+M[i-1][j-weights[i-1]]:M[i-1][j]);
			else
				M[i][j]=M[i-1][j];
		}
	}
	return M[n][m];
}
int main(){
	int n;
	scanf("%d",&amp;n);
	int weights[n];
	for(int i=0;i&lt;n;i++){
		scanf("%d",&amp;weights[i]);
	}
	int profits[n];
	for(int i=0;i&lt;n;i++){
		scanf("%d",&amp;profits[i]);
	}
	int capacity;
	scanf("%d",&amp;capacity);
	int maxprofit = knapsack(weights,n,profits,capacity);
	printf("%d\n",maxprofit);
	return 0;
}</pre><br data-ref="f2e3522e-54c9-4bc6-a959-915189ef32c8"></div></div><div class="row" data-ref="67038e8c-3df8-4b9a-9c05-9690d72ad0e2"><div class="col-12" data-ref="6aaa2cb3-2a02-42e0-9140-2e238d7d0106"><h5 class="execResultsHeading text-center" data-ref="2d9af4eb-d19e-4849-a78a-12ea7a6ae8e2">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="2f710bcf-4550-4c35-87a5-c458e131eaba" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="18cb3c61-3a12-422c-acef-2e29d262fee3"><div class="row execution-results-border" data-ref="5c686e88-c42a-4870-9bdf-dff6ff4add4e"><div class="col-12 p-2 text-center font-weight-bold" data-ref="0696d5d7-2201-47ca-ab1e-9ba85db4cfa0">Test Case - 1</div></div><div class="row execution-results-border" data-ref="08dcc63a-4308-479d-bf70-16e19aa5ebf2"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="5b1e60a1-f8fe-4281-be4a-94f992644002">User Output</div></div><div class="row execution-results-border" data-ref="56e47534-9fa3-41e1-aad7-1933084581ea"><div class="col-6" data-ref="dc5d55aa-8b58-4863-94d2-52e0f0db1197"><span class="cmd" title="User Input" data-ref="36cd70e5-c90f-4caa-9f72-1f42e70b7353">5</span></div></div><div class="row execution-results-border" data-ref="d0c709a0-3e51-4174-be58-12e415b7592d"><div class="col-6" data-ref="0ae69fed-3db4-4df0-b8c6-930bd3e51323"><span class="cmd" title="User Input" data-ref="40a2ca12-f9f3-415d-8b82-8429d48e0179">5 10 15 20 25</span></div></div><div class="row execution-results-border" data-ref="45880fce-80dd-4619-9fff-f448beece969"><div class="col-6" data-ref="2960f083-682b-467a-93d6-92ade6c33ec9"><span class="cmd" title="User Input" data-ref="97baef80-c454-4ab8-a812-3332b58071b8">10 20 30 40 50</span></div></div><div class="row execution-results-border" data-ref="58cc3a15-6961-4de7-a21a-ebedb1eced46"><div class="col-6" data-ref="6c79d71f-fcaa-41ce-8e9a-95f654e252dc"><span class="cmd" title