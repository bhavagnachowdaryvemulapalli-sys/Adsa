-e7fd-44f9-b0c6-8294e381ac20"><b style="border-bottom:1px solid black;" data-ref="47ed5b2e-a192-4cad-b36f-a7e5debda6da" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="6ea48628-fded-4adc-a3bb-1ff06851a542" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="0b9d201c-f6ee-4a92-a4eb-6dce3a8f509a" data-undisplayed="undisplayed">CTC64641.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="b0b68013-4384-4315-80ba-530313c6b659" data-undisplayed="undisplayed">#include&lt;stdio.h&gt;
#define MAX 10
int adj[MAX][MAX];
int visited[MAX];
int stack[MAX];
int top=-1;
int n;
void push(int v){
	stack[++top] = v;
}
int pop(){
	return stack[top--];
}
int isEmpty(){
	return(top==-1);
}
void dfs_stack(int start){
	push(start);
	visited[start]=1;
	while(!isEmpty()){
		int current = pop();
		printf("%d ",current);
		for(int i=n;i&gt;=0;i--){
			if(adj[current][i]==1 &amp;&amp; !visited[i]){
				push(i);
				visited[i]=1;
			}
		}
	}
}
int main(){
int edges,u,v,start;
	scanf("%d",&amp;n);
	scanf ("%d",&amp;edges);
	for(int i=0;i&lt;n;i++){
		visited[i]=0;
	for(int j=0;j&lt;n;j++){
		adj[i][j]=0;
	}
}
for(int i=0;i&lt;edges;i++){
	scanf("%d %d",&amp;u,&amp;v);
	adj[u][v] = 1;
	adj[v][u] = 1;
}
scanf("%d",&amp;start);
dfs_stack(start);
return 0;}</pre><br data-ref="1be6e455-f84d-4232-bf51-4be8b717b94d"></div></div><div class="row" data-ref="6eaa0b09-b3aa-4dda-bcfb-87d95a8d3dc6"><div class="col-12" data-ref="54d87a3c-c73a-48f7-9ece-45ce5feead8b"><h5 class="execResultsHeading text-center" data-ref="d0227d08-9d76-4636-bf2f-713d7fb422c3">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="ab24693b-2222-40f0-9898-00a5e939c5ea" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="902f65e0-f442-4f98-b0d7-80a6f548b2ba"><div class="row execution-results-border" data-ref="69bc1e83-3341-4b00-9a84-5e789710935d"><div class="col-12 p-2 text-center font-weight-bold" data-ref="827a763b-5511-480a-bd53-0087c7c50279">Test Case - 1</div></div><div class="row execution-results-border" data-ref="fa7962fc-96da-4b1d-aefa-91963e7c3819"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="04b53681-3f5c-42b8-b499-8c0aa3255235">User Output</div></div><div class="row execution-results-border" data-ref="9bb272d6-7ee9-4fbd-a474-125da8f28222"><div class="col-6" data-ref="cd3e5404-a010-48d3-94a8-a29579523f79"><span class="cmd" title="User Input" data-ref="ebd27c6d-6ee1-49f7-9112-b0c90b6e1236">4</span></div></div><div class="row execution-results-border" data-ref="507e1ad7-9e90-4fd7-ba83-d56f000786b0"><div class="col-6" data-ref="c83e5426-4ea5-44ca-bcbf-9a45504f9161"><span class="cmd" title="User Input" data-ref="a00c880d-83da-4e1e-977a-d80613eb1d97">4</span></div></div><div class="row execution-results-border" data-ref="6199933f-8cc5-4583-a478-3eff1238fb0e"><div class="col-6" data-ref="31483a43-6971-4f71-a4bd-d09d467a6d70"><span class="cmd" title="User Input" data-ref="949d6aa2-5584-4c53-b7af-8143cd03948f">0 1</span></div></div><div class="row execution-results-border" data-ref="4c133536-5e09-4190-aa2a-92ed6e1c3f16"><div class="col-6" data-ref="ed805d89-a3e8-478f-be93-1d0dbd8cb066"><span class="cmd" title="User Input" 