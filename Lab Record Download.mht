reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="274a9012-beed-41d6-b9c6-7e4c8ce27f88"></p><p data-ref="9938f0de-addc-4109-8762-c553690e1945" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="79077514-e9d0-4deb-8a73-9afa4d8f8c15">Output Format:</strong></p><ul data-ref="1927c17e-d400-4f49-a0dc-b91e0323d092" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><li data-ref="0197dcb8-b1b5-4a68-9e0d-ea250ebeabb5">The first line of output should display the inorder traversal of the B-Tree after all insertions, with each key separated by a space.</li><li data-ref="f1fc36d0-e7a5-4cea-8591-521efc957961">The second line should display the inorder traversal of the B-Tree after all deletions, with each key separated by a space.</li><li data-ref="cc38a7d7-a158-4c57-be20-28a576d33ee1">The third line should print <strong data-ref="89927c97-2178-462d-b413-2789e2ddc2f3">Found</strong> if the search key exists in the B-Tree. If the key is not present, print <strong data-ref="2d485cc0-4024-4e6a-add8-d318cfb0173b">Not Found</strong> instead.</li></ul><p data-ref="34b39141-f0ab-4e33-9e38-5fef4421b574" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="5e28df96-c19f-4f20-a150-1ddd141f75f2"></p><p data-ref="9327f509-dc75-44dd-8a5f-5be03aadcaad" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="fda2ed08-3e12-46ac-870b-f4495048486e"></p><p data-ref="e9a6d71b-a1cd-4b00-b4cf-e0893612223a" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><strong data-ref="45b1c6ea-288a-4a02-974f-121e85d89d52">Note: </strong>Refer to the test cases for better understanding.</p></span></div><div class="mb-3" data-ref="a8eb283a-aa7c-4921-aa1e-cf2a662d0124"><div class="ml-1 mb-3" data-ref="c76f5d23-6bea-4c4f-81b2-1912b37d1b40"><b style="border-bottom:1px solid black;" data-ref="cb88bd20-2cc4-41a3-a40e-1df59dc9168f" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="8bfb0d63-7c49-4020-a271-3bf62d690f70" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="7e598eb8-3cd1-49b4-98d1-79446c5eb87d" data-undisplayed="undisplayed">Btreemain.c</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="585167e1-1557-43e7-b42c-9f923a21e362" data-undisplayed="undisplayed">#include &lt;stdio.h&gt;
#include &lt;stdlib.h&gt;
#include &lt;stdbool.h&gt;
typedef struct BTreeNode {
    int *keys;
    int t;
    struct BTreeNode **C;
    int n;
    bool leaf;
} BTreeNode;
BTreeNode* createNode(int t, bool leaf) {
    BTreeNode* node = (BTreeNode*)malloc(sizeof(BTreeNode));
    node-&gt;t = t;
    node-&gt;leaf = leaf;
    node-&gt;keys = (int*)malloc((2 * t - 1) * sizeof(int));
    node-&gt;C = (BTreeNode**)malloc((2 * t) * sizeof(BTreeNode*));
    node-&gt;n = 0;
    return node;
}
void inorder(BTreeNode* root) {
    if (!root) return;
    for (int i = 0; i &lt; root-&gt;n; i++) {
        if (!root-&gt;leaf)
            inorder(root-&gt;C[i]);
        printf("%d ", root-&gt;keys[i]);
    }
    if (!root-&gt;leaf)
        inorder(root-&gt;C[root-&gt;n]);
}
bool search(BTreeNode* root, int k) {
    int i = 0;
    while (i &lt; root-&gt;n &amp;&amp; k &gt; root-&gt;keys[i])
        i++;
    if (i &lt; root-&gt;n &amp;&amp; root-&gt;keys[i] == k)
        return true;
    if (root-&gt;leaf)
        return false;
    return search(root-&gt;C[i], k);
}
void splitChild(BTreeNode* x, int i) {
    int t = x-&gt;t;
    BTreeNode* y = x-&gt;C[i];
    BTreeNode* z = createNode(t, y-&gt;leaf);
    z-&gt;n = t - 1;
    for (int j = 0; j &lt; t - 1; j++)
        z-&gt;keys[j] = y-&gt;keys[j + t];
    if (!y-&gt;leaf) {
        for (int j = 0; j &lt; t; j++)
            z-&gt;C[j] = y-&gt;C[j + t];
    }
    y-&gt;n = t - 1;
    for (int j = x-&gt;n; j &gt;= i + 1; j--)
        x-&gt;C[j + 1] = x-&gt;C[j];
    x-&gt;C[i + 1] = z;
    for (int j = x-&gt;n - 1; j &gt;= i; j--)
        x-&gt;keys[j + 1] = x-&gt;keys[j];
    x-&gt;keys[i] = y-&gt;keys[t - 1];
    x-&gt;n++;
}
void insertNonFull(BTreeNode* x, int k) {
    int i = x-&gt;n - 1;
    if (x-&gt;leaf) {
        while (i &gt;= 0 &amp;&amp; k &lt; x-&gt;keys[i]) {
            x-&gt;keys[i + 1] = x-&gt;keys[i];
            i--;
        }
        x-&gt;keys[i + 1] = k;
        x-&gt;n++;
    } else {
        while (i &gt;= 0 &amp;&amp; k &lt; x-&gt;keys[i])
            i--;
        i++;
        if (x-&gt;C[i]-&gt;n == 2 * x-&gt;t - 1) {
            splitChild(x, i);
            if (k &gt; x-&gt;keys[i])
                i++;
        }
        insertNonFull(x-&gt;C[i], k);
    }
}
void insert(BTreeNode** rootRef, int k) {
    BTreeNode* r = *rootRef;
    if (r-&gt;n == 2 * r-&gt;t - 1) {
        BTreeNode* s = createNode(r-&gt;t, false);
        s-&gt;C[0] = r;
        splitChild(s, 0);
        int i = (k &gt; s-&gt;keys[0]) ? 1 : 0;
        insertNonFull(s-&gt;C[i], k);
        *rootRef = s;
    } else {
        insertNonFull(r, k);
    }
}
int getPred(BTreeNode* x) {
    while (!x-&gt;leaf)
        x = x-&gt;C[x-&gt;n];
    return x-&gt;keys[x-&gt;n - 1];
}
int getSucc(BTreeNode* x) {
    while (!x-&gt;leaf)
        x = x-&gt;C[0];
    return x-&gt;keys[0];
}
void merge(BTreeNode* x, int idx) {
    BTreeNode* c1 = x-&gt;C[idx];
    BTreeNode* c2 = x-&gt;C[idx + 1];
    int t = x-&gt;t;
    c1-&gt;keys[t - 1] = x-&gt;keys[idx];
    for (int i = 0; i &lt; c2-&gt;n; ++i)
        c1-&gt;keys[i + t] = c2-&gt;keys[i];
    if (!c1-&gt;leaf) {
        for (int i = 0; i &lt;= c2-&gt;n; ++i)
            c1-&gt;C[i + t] = c2-&gt;C[i];
    }
    for (int i = idx + 1; i &lt; x-&gt;n; ++i)
        x-&gt;keys[i - 1] = x-&gt;keys[i];
    for (int i = idx + 2; i &lt;= x-&gt;n; ++i)
        x-&gt;C[i - 1] = x-&gt;C[i];
    c1-&gt;n += c2-&gt;n + 1;
    x-&gt;n--;
    free(c2);
}
void fill(BTreeNode* x, int idx) {
    int t = x-&gt;t;
    if (idx &gt; 0 &amp;&amp; x-&gt;C[idx - 1]-&gt;n &gt;= t) {
        BTreeNode* child = x-&gt;C[idx];
        BTreeNode* sibling = x-&gt;C[idx - 1];
        for (int i = child-&gt;n - 1; i &gt;= 0; --i)
            child-&gt;keys[i + 1] = child-&gt;keys[i];
        if (!child-&gt;leaf) {
            for (int i = child-&gt;n; i &gt;= 0; --i)
                child-&gt;C[i + 1] = child-&gt;C[i];
        }
        child-&gt;keys[0] = x-&gt;keys[idx - 1];
        if (!child-&gt;leaf)
            child-&gt;C[0] = sibling-&gt;C[sibling-&gt;n];
        x-&gt;keys[idx - 1] = sibling-&gt;keys[sibling-&gt;n - 1];
        child-&gt;n += 1;
        sibling-&gt;n -= 1;
    } else if (idx &lt; x-&gt;n &amp;&amp; x-&gt;C[idx + 1]-&gt;n &gt;= t) {
        BTreeNode* child = x-&gt;C[idx];
        BTreeNode* sibling = x-&gt;C[idx + 1];
        child-&gt;keys[child-&gt;n] = x-&gt;keys[idx];
        if (!child-&gt;leaf)
            child-&gt;C[child-&gt;n + 1] = sibling-&gt;C[0];
        x-&gt;keys[idx] = sibling-&gt;keys[0];
        for (int i = 1; i &lt; sibling-&gt;n; ++i)
            sibling-&gt;keys[i - 1] = sibling-&gt;keys[i];
        if (!sibling-&gt;leaf) {
            for (int i = 1; i &lt;= sibling-&gt;n; ++i)
                sibling-&gt;C[i - 1] = sibling-&gt;C[i];
        }
        child-&gt;n += 1;
        sibling-&gt;n -= 1;
    } else {
        if (idx != x-&gt;n)
            merge(x, idx);
        else
            merge(x, idx - 1);
    }
}
void removeFromNode(BTreeNode* x, int k) {
    int idx = 0;
    while (idx &lt; x-&gt;n &amp;&amp; x-&gt;keys[idx] &lt; k)
        ++idx;
    if (idx &lt; x-&gt;n &amp;&amp; x-&gt;keys[idx] == k) {
        if (x-&gt;leaf) {
            for (int i = idx + 1; i &lt; x-&gt;n; ++i)
                x-&gt;keys[i - 1] = x-&gt;keys[i];
            x-&gt;n--;
        } else {
            if (x-&gt;C[idx]-&gt;n &gt;= x-&gt;t) {
                int pred = getPred(x-&gt;C[idx]);
                x-&gt;keys[idx] = pred;
                removeFromNode(x-&gt;C[idx], pred);
            } else if (x-&gt;C[idx + 1]-&gt;n &gt;= x-&gt;t) {
                int succ = getSucc(x-&gt;C[idx + 1]);
                x-&gt;keys[idx] = succ;
                removeFromNode(x-&gt;C[idx + 1], succ);
            } else {
                merge(x, idx);
                removeFromNode(x-&gt;C[idx], k);
            }
        }
    } else {
        if (x-&gt;leaf)
            return;
        bool flag = (idx == x-&gt;n);
        if (x-&gt;C[idx]-&gt;n &lt; x-&gt;t)
            fill(x, idx);
        if (flag &amp;&amp; idx &gt; x-&gt;n)
            removeFromNode(x-&gt;C[idx - 1], k);
        else
            removeFromNode(x-&gt;C[idx], k);
    }
}

void deleteKey(BTreeNode** rootRef, int k) {
    BTreeNode* r = *rootRef;
    removeFromNode(r, k);
    if (r-&gt;n == 0) {
        BTreeNode* tmp = r;
        if (r-&gt;leaf)
            *rootRef = NULL;
        else
            *rootRef = r-&gt;C[0];
        free(tmp);
    }
}
int main() {
    int t;
    scanf("%d", &amp;t);
    BTreeNode* root = createNode(t, true);
    int n, val;
    scanf("%d", &amp;n);
    for (int i = 0; i &lt; n; i++) {
        scanf("%d", &amp;val);
        insert(&amp;root, val);
	}
    inorder(root);
    int d;
    scanf("%d", &amp;d);
    for (int i = 0; i &lt; d; i++) {
        scanf("%d", &amp;val);
        deleteKey(&amp;root, val);
	}
    inorder(root);
    int target;
    scanf("%d\n", &amp;target);
    if (search(root, target))
        printf("Found\n");
    else
        printf("Not Found\n");
    return 0;
}</pre><br data-ref="3b7baf1e-8ced-4988-935a-e08240033d39"></div></div><div class="row" data-ref="ea380401-66d6-4f8b-959b-b315439bcc8a"><div class="col-12" data-ref="79159d9b-70e9-434d-8091-c79bbfe6882e"><h5 class="execResultsHeading text-center" data-ref="0a9ca312-a089-40a8-a05d-445dca39c7d5">Execution Results <span class="executionResultsStatusSpan" style="font-size:0.9rem;" data-ref="124a56de-e58a-4853-9961-2ca974dc04b6" data-undisplayed="undisplayed">- All test cases have succeeded!</span></h5></div></div><div class="mb-4 mx-4" data-ref="c09a2ddc-affe-4d9b-8f26-e37d01a59fa9"><div class="row execution-results-border" data-ref="66f8c92d-807d-4ac3-a2d9-2095426aa3bb"><div class="col-12 p-2 text-center font-weight-bold" data-ref="c3a7f1f0-01f2-4159-837c-b942bf85ad83">Test Case - 1</div></div><div class="row execution-results-border" data-ref="49c3cf31-870a-484c-b21f-aee41e40208a"><div class="col-12 p-1 ml-2 font-weight-bold" data-ref="230359be-5933-426a-a0be-cdb96cc21f85">User Output</div></div><div class="row execution-results-border" data-ref="14404101-5a11-44bd-a37e-0107cea13fe3"><div class="col-6" data-ref="4a0af6c6-b64c-4950-96d4-29a88ae2effc"><span class="cmd" title="User Input" data-ref="26d13472-96f3-4a90-9e62-2df51699756e">2</span></div></div><div class="row execution-results-border" data-ref="0bc752e8-f26c-467d-8bce-645f34bb286b"><div class="col-6" data-ref="bf67b93a-6155-45eb-b74e-95b762a31f8a"><span class="cmd" title="User Input" data-ref="92356819-c66c-4d09-86fd-d5838b9d4c26">7</span></div></div><div class="row execution-results-border" data-ref="227f5fc2-b123-42c7-8847-84ece760fda3"><div class="col-6" data-ref="cb8347ec-4888-4a59-8c6e-87ea054d7d70"><span class="cmd" title="User Input" data-ref="af42849f-10a3-4929-a9b5-e769995d9771">10 20 5 6 12 30 7</span></div></div><div class="row execution-results-border" data-ref="b27e734a-3d85-4af1-bed3-066bb639eeaf"><div class="col-6" data-ref="cd5012af-85bf-4858-b597-bec74e0c7e5d"><span class="cmd" title="User In